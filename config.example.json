{
  "supabase": {
    "url": "https://your-project.supabase.co",
    "anonKey": "your-anon-key-here",
    "serviceRoleKey": "your-service-role-key-here"
  },
  "mcp": {
    "serverName": "supabase-server",
    "version": "1.0.0",
    "capabilities": {
      "database": true,
      "storage": true,
      "realtime": true,
      "auth": true
    }
  },
  "security": {
    "allowedOrigins": ["*"],
    "rateLimit": {
      "requestsPerMinute": 60
    }
  },
  "database": {
    "poolSize": 10,
    "maxQueriesPerConnection": 5
  }
}
